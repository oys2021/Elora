NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=elora
DB_USER=postgres
DB_PASSWORD=postgres

# Free tier at https://cloudinary.com/users/register/free
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Outgoing email (password reset).
#
# Preferred: Resend, sent over HTTPS (not SMTP). Get a free API key at
# https://resend.com/api-keys — no domain setup needed to start, since
# EMAIL_FROM defaults to Resend's shared sandbox sender.
RESEND_API_KEY=

# Fallback, used only if RESEND_API_KEY is blank: plain SMTP via Nodemailer.
# Some networks/hosts block outbound SMTP entirely — if password resets never
# arrive, use Resend (or another HTTP-API provider) instead.
# Leave all of these blank, with no RESEND_API_KEY either, and a throwaway
# Ethereal test inbox is used automatically — nothing arrives in a real
# mailbox, but the server console prints a link to preview what was sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# "true" only if SMTP_PORT is 465; leave blank/false otherwise.
SMTP_SECURE=

# Online payments (Mobile Money / card) via Paystack.
# Dashboard -> Settings -> API Keys & Webhooks. Use the TEST secret key
# (sk_test_...) while testing; swapping in sk_live_... is the only change for
# live. Leave blank to disable online payment (cash still works).
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=GHS
# Unpaid online orders are cancelled (stock released) after this long.
PAYSTACK_PAYMENT_TIMEOUT_MINUTES=30
# How often the server re-checks pending payments with Paystack.
PAYSTACK_RECONCILE_INTERVAL_MINUTES=5
# TESTING ONLY: charge this flat amount (GHS) instead of the order total.
# Leave blank / remove before taking real orders.
PAYSTACK_AMOUNT_OVERRIDE=
# Our webhook, to paste into the dashboard's "Webhook URL" (must be public
# HTTPS, e.g. through a tunnel while testing locally — optional, payments are
# confirmed without it too):
#   https://<your-domain>/api/v1/payments/paystack/webhook

# Where store alerts go (new orders, payments, contact messages). Comma-separated
# for several. Leave blank to send them to every admin account's email.
STORE_EMAIL=

# Used by both methods above. Until you verify your own domain with Resend,
# leave this blank to use their shared sandbox sender.
EMAIL_FROM="Elora <no-reply@elora.local>"
